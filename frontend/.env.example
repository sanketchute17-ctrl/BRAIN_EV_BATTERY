# BRAIN EV Battery Risk & Analytics Network - Environment Configuration
# Copy this file to '.env' in the frontend directory and replace values with your project credentials.

# 1. Firebase Cloud Database & Authentication (Google Firebase)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# 2. Supabase Cloud Database & Authentication (Alternative Option)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 3. Local FastAPI Backend URL (Optional if running python app/main.py locally)
VITE_API_URL=http://localhost:8000/api/v1

# BRAIN EV Battery Risk & Analytics Network - Environment Configuration
# Copy this file to '.env' in the frontend directory and replace values with your project credentials.

# 1. Groq Cloud AI Key (Free fast Llama-3 AI for Battery Risk Analysis)
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Supabase Cloud Database & Authentication (Free 50,000 users - Recommended when Firebase limit is reached)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 3. Google Firebase Cloud Authentication
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# 4. Local FastAPI Backend URL
VITE_API_URL=http://localhost:8000/api/v1

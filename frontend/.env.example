# BRAIN EV Battery Risk & Analytics Network - Environment Configuration
# Copy this file to '.env' in the frontend directory and replace values with your project credentials.

# 1. Supabase Cloud Database & Authentication (Recommended for Cloud Auth)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Local FastAPI Backend URL (Optional if running python app/main.py locally)
VITE_API_URL=http://localhost:8000/api/v1
